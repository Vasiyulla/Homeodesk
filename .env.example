# Backend Environment Variables
# Copy this file to .env in the backend/ directory and update values as needed

# Database Configuration
# PostgreSQL is required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/homeopathy

# Application Environment
ENV=development

# API Configuration
# Only needed if running backend on non-standard port
API_HOST=127.0.0.1
API_PORT=8000

# Frontend Configuration
# Only needed if running frontend on non-standard port
FRONTEND_URL=http://localhost:3000
