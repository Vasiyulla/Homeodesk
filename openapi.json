dation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/repertory/rubric/{chapter}/{main_rubric}":{"get":{"summary":"Get Rubric Remedies","description":"Get all remedies for a specific rubric.","operationId":"get_rubric_remedies_repertory_rubric__chapter___main_rubric__get","parameters":[{"name":"chapter","in":"path","required":true,"schema":{"type":"string","title":"Chapter"}},{"name":"main_rubric","in":"path","required":true,"schema":{"type":"string","title":"Main Rubric"}},{"name":"sub_condition","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Sub Condition"}},{"name":"source","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/repertory/search/fuzzy":{"get":{"summary":"Fuzzy Search","description":"Fuzzy search for rubrics with similarity scoring.","operationId":"fuzzy_search_repertory_search_fuzzy_get","parameters":[{"name":"q","in":"query","required":true,"schema":{"type":"string","description":"Search query","title":"Q"},"description":"Search query"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","description":"Max results to return","default":10,"title":"Limit"},"description":"Max results to return"},{"name":"source","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Filter by source","title":"Source"},"description":"Filter by source"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/repertory/verify":{"get":{"summary":"Verify Data","description":"Verify that data has been loaded correctly.","operationId":"verify_data_repertory_verify_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/symptom-search":{"post":{"summary":"Search Symptom","description":"Search for a symptom and get matching repertory rubrics.\n\nTakes free-text symptom input and returns matching rubrics with:\n- Similarity score (how well symptom matches rubric)\n- Remedy count (how many remedies are in this rubric)\n- Confidence level (HIGH/MEDIUM/LOW)\n- Source (Kent/Boger)\n\nExample:\n    POST /api/symptom-search\n    {\n        \"symptom\": \"throbbing headache from stress\",\n        \"source\": \"both\",\n        \"limit\": 10,\n        \"min_confidence\": \"LOW\"\n    }\n\nReturns:\n    {\n        \"symptom\": \"throbbing headache from stress\",\n        \"count\": 8,\n        \"results\": [\n            {\n                \"chapter\": \"Head\",\n                \"main_rubric\": \"PAIN\",\n                \"sub_condition\": \"throbbing\",\n                \"similarity_score\": 0.92,\n                \"remedy_count\": 18,\n                \"confidence\": \"HIGH\",\n                \"source\": \"kent\"\n            },\n            ...\n        ]\n    }","operationId":"search_symptom_api_symptom_search_post","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SymptomSearchRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"summary":"Search Symptom Get","description":"GET version of symptom search (for simple URL-based queries).\n\nExample:\n    GET /api/symptom-search?symptom=headache&source=both&limit=10","operationId":"search_symptom_get_api_symptom_search_get","parameters":[{"name":"symptom","in":"query","required":true,"schema":{"type":"string","description":"Free-text symptom","title":"Symptom"},"description":"Free-text symptom"},{"name":"source","in":"query","required":false,"schema":{"type":"string","description":"Kent, Boger, or both","default":"both","title":"Source"},"description":"Kent, Boger, or both"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","description":"Max rubrics to return","default":10,"title":"Limit"},"description":"Max rubrics to return"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/symptom-search/by-category":{"post":{"summary":"Search By Category","description":"Search symptoms organized by homeopathic categories.\n\nThis endpoint is useful for structured case-taking where symptoms\nare already organized by Mental/General/Particular/Causation.\n\nExample:\n    POST /api/symptom-search/by-category\n    {\n        \"mental_symptoms\": [\"anxiety\", \"irritability\"],\n        \"general_symptoms\": [\"fever\"],\n        \"particular_symptoms\": [\"throbbing head\"],\n        \"causation_symptoms\": [\"worse from stress\"],\n        \"source\": \"both\"\n    }\n\nReturns:\n    {\n        \"Mental\": [\n            {\n                \"chapter\": \"Mind\",\n                \"main_rubric\": \"ANXIETY\",\n                ...\n            },\n            ...\n        ],\n        \"General\": [...],\n        \"Particular\": [...],\n        \"Causation\": [...]\n    }","operationId":"search_by_category_api_symptom_search_by_category_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SymptomByCategoryRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/symptom-search/top/{symptom}":{"get":{"summary":"Get Top Rubrics","description":"Get only the top N rubrics for a symptom.\n\nUseful for quick recommendations and shortlisting.\n\nExample:\n    GET /api/symptom-search/top/headache?count=3&source=both\n\nReturns:\n    {\n        \"symptom\": \"headache\",\n        \"count\": 3,\n        \"results\": [\n            {\n                \"chapter\": \"Head\",\n                \"main_rubric\": \"PAIN\",\n                \"sub_condition\": \"throbbing\",\n                \"similarity_score\": 0.92,\n                \"remedy_count\": 18,\n                \"confidence\": \"HIGH\",\n                \"source\": \"kent\"\n            },\n            ...\n        ]\n    }","operationId":"get_top_rubrics_api_symptom_search_top__symptom__get","parameters":[{"name":"symptom","in":"path","required":true,"schema":{"type":"string","title":"Symptom"}},{"name":"count","in":"query","required":false,"schema":{"type":"integer","description":"Number of top rubrics","default":3,"title":"Count"},"description":"Number of top rubrics"},{"name":"source","in":"query","required":false,"schema":{"type":"string","description":"Kent, Boger, or both","default":"both","title":"Source"},"description":"Kent, Boger, or both"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/repertorize":{"post":{"summary":"Repertorize","description":"Score remedies based on selected rubrics with category weights.\n\nImplements classic homeopathic repertorization:\nScore = Σ(remedy_grade × symptom_weight)\n\nExample:\n    POST /api/repertorize\n    {\n        \"rubrics\": [\n            {\n                \"chapter\": \"Mind\",\n                \"main_rubric\": \"ANXIETY\",\n                \"sub_condition\": \"from stress\",\n                \"category\": \"Mental\",\n                \"source\": \"both\"\n            },\n            {\n                \"chapter\": \"Head\",\n                \"main_rubric\": \"PAIN\",\n                \"sub_condition\": \"throbbing\",\n                \"category\": \"Particular\",\n                \"source\": \"both\"\n            }\n        ],\n        \"weights\": {\n            \"Mental\": 5,\n            \"Particular\": 2\n        },\n        \"source\": \"both\",\n        \"limit\": 10\n    }\n\nReturns:\n    {\n        \"case_id\": \"unique-case-id\",\n        \"symptom_count\": 2,\n        \"remedy_count\": 10,\n        \"remedies\": [\n            {\n                \"rank\": 1,\n                \"remedy\": \"Nux-v\",\n                \"total_score\": 35,\n                \"rubric_count\": 2,\n                \"avg_grade\": 3.5,\n                \"confidence\": \"HIGH\",\n                \"breakdown\": [\n                    {\n                        \"chapter\": \"Mind\",\n                        \"main_rubric\": \"ANXIETY\",\n                        \"grade\": 3,\n                        \"weight\": 5,\n                        \"contribution\": 15\n                    },\n                    {\n                        \"chapter\": \"Head\",\n                        \"main_rubric\": \"PAIN\",\n                        \"grade\": 4,\n                        \"weight\": 2,\n                        \"contribution\": 8\n                    }\n                ]\n            },\n            ...\n        ],\n        \"methodology\": \"Homeopathic Weighted Repertorization\"\n    }","operationId":"repertorize_api_repertorize_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RepertorizeRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/remedies/compare":{"post":{"summary":"Compare Remedies","description":"Compare two remedies side-by-side across selected rubrics.\n\nShows:\n- Where both remedies appear (and which is stronger)\n- Where only remedy1 appears\n- Where only remedy2 appears\n- Total scores and coverage\n\nExample:\n    POST /api/remedies/compare\n    {\n        \"remedy1\": \"Nux-v\",\n        \"remedy2\": \"Sulph\",\n        \"rubrics\": [\n            {\n                \"chapter\": \"Mind\",\n                \"main_rubric\": \"ANXIETY\",\n                \"category\": \"Mental\"\n            },\n            ...\n        ],\n        \"weights\": {\"Mental\": 5, \"Particular\": 2}\n    }\n\nReturns:\n    {\n        \"remedy1\": {\n            \"name\": \"Nux-v\",\n            \"total_score\": 35,\n            \"rubric_count\": 2,\n            \"avg_grade\": 3.5\n        },\n        \"remedy2\": {\n            \"name\": \"Sulph\",\n            \"total_score\": 20,\n            \"rubric_count\": 2,\n            \"avg_grade\": 2.5\n        },\n        \"supporting_both\": [\n            {\n                \"rubric\": \"Mind/ANXIETY\",\n                \"remedy1_grade\": 3,\n                \"remedy2_grade\": 2,\n                \"winner\": \"Nux-v\"\n            }\n        ],\n        \"supporting_1_only\": [...],\n        \"supporting_2_only\": [...]\n    }","operationId":"compare_remedies_api_remedies_compare_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CompareRemediesRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/remedy/{remedy}/profile":{"post":{"summary":"Get Remedy Profile","description":"Get detailed profile of a single remedy.\n\nShows:\n- Total coverage score across selected symptoms\n- Chapters where remedy is strongest/weakest\n- Grade distribution\n- Detailed list of all appearances\n\nExample:\n    POST /api/remedy/Nux-v/profile\n    {\n        \"remedy\": \"Nux-v\",\n        \"rubrics\": [\n            {\"chapter\": \"Mind\", \"main_rubric\": \"ANXIETY\", \"category\": \"Mental\"},\n            {\"chapter\": \"Head\", \"main_rubric\": \"PAIN\", \"category\": \"Particular\"}\n        ],\n        \"weights\": {\"Mental\": 5, \"Particular\": 2}\n    }\n\nReturns:\n    {\n        \"remedy\": \"Nux-v\",\n        \"total_score\": 35,\n        \"rubric_count\": 2,\n        \"avg_grade\": 3.5,\n        \"chapters_covered\": [\"Mind\", \"Head\"],\n        \"strong_chapters\": [\n            {\"chapter\": \"Head\", \"avg_grade\": 4.0},\n            {\"chapter\": \"Mind\", \"avg_grade\": 3.0}\n        ],\n        \"weak_chapters\": [],\n        \"all_appearances\": [\n            {\n                \"chapter\": \"Mind\",\n                \"main_rubric\": \"ANXIETY\",\n                \"grade\": 3,\n                \"weight\": 5,\n                \"contribution\": 15\n            },\n            ...\n        ]\n    }","operationId":"get_remedy_profile_api_remedy__remedy__profile_post","parameters":[{"name":"remedy","in":"path","required":true,"schema":{"type":"string","title":"Remedy"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RemedyProfileRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/shortlist/analyze":{"post":{"summary":"Analyze Shortlist","description":"Analyze entire shortlist and identify unique indications.\n\nShows what each remedy specializes in - where it appears\nbut other shortlist remedies don't.\n\nExample:\n    POST /api/shortlist/analyze\n    {\n        \"remedies\": [\"Nux-v\", \"Sulph\", \"Lach\"],\n        \"rubrics\": [\n            {\"chapter\": \"Mind\", \"main_rubric\": \"ANXIETY\", \"category\": \"Mental\"},\n            {\"chapter\": \"Head\", \"main_rubric\": \"PAIN\", \"category\": \"Particular\"},\n            {\"chapter\": \"Abdomen\", \"main_rubric\": \"DIARRHEA\", \"category\": \"General\"}\n        ],\n        \"weights\": {\"Mental\": 5, \"Particular\": 2, \"General\": 3}\n    }\n\nReturns:\n    {\n        \"shortlist_size\": 3,\n        \"remedies\": [\n            {\n                \"rank\": 1,\n                \"remedy\": \"Nux-v\",\n                \"total_score\": 45,\n                \"rubric_count\": 3,\n                \"avg_grade\": 3.0,\n                \"chapters_covered\": [\"Mind\", \"Head\", \"Abdomen\"],\n                \"strong_chapters\": [...],\n                \"unique_indications_count\": 1,\n                \"unique_indications\": [\n                    {\n                        \"chapter\": \"Abdomen\",\n                        \"main_rubric\": \"DIARRHEA\",\n                        \"avg_grade\": 3.5\n                    }\n                ]\n            },\n            ...\n        ]\n    }","operationId":"analyze_shortlist_api_shortlist_analyze_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ShortlistAnalysisRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/remedies/differentiate":{"post":{"summary":"Differentiate Remedies","description":"Detailed head-to-head comparison of two remedies.\n\nDetermines which is more suitable for the case and explains why.\n\nExample:\n    POST /api/remedies/differentiate\n    {\n        \"remedy1\": \"Nux-v\",\n        \"remedy2\": \"Sulph\",\n        \"rubrics\": [\n            {\"chapter\": \"Mind\", \"main_rubric\": \"ANXIETY\", \"category\": \"Mental\"},\n            {\"chapter\": \"Head\", \"main_rubric\": \"PAIN\", \"category\": \"Particular\"},\n            {\"chapter\": \"Abdomen\", \"main_rubric\": \"DIARRHEA\", \"category\": \"General\"}\n        ],\n        \"weights\": {\"Mental\": 5, \"Particular\": 2, \"General\": 3}\n    }\n\nReturns:\n    {\n        \"remedy1\": \"Nux-v\",\n        \"remedy2\": \"Sulph\",\n        \"winner\": \"Nux-v\",\n        \"supporting_both\": [\n            {\n                \"rubric\": \"Mind/ANXIETY\",\n                \"remedy1\": \"Nux-v\",\n                \"remedy2\": \"Sulph\",\n                \"remedy1_grade\": 3,\n                \"remedy2_grade\": 2,\n                \"winner\": \"Nux-v\",\n                \"strength_diff\": 1\n            }\n        ],\n        \"supporting_1_only\": [\n            {\n                \"rubric\": \"Abdomen/DIARRHEA\",\n                \"grade\": 3\n            }\n        ],\n        \"supporting_2_only\": [\n            {\n                \"rubric\": \"Head/PAIN\",\n                \"grade\": 4\n            }\n        ],\n        \"strength_comparison\": {\n            \"Nux-v_score\": 40,\n            \"Sulph_score\": 25,\n            \"difference\": 15,\n            \"Nux-v_rubric_count\": 3,\n            \"Sulph_rubric_count\": 2,\n            \"Nux-v_avg_grade\": 2.67,\n            \"Sulph_avg_grade\": 2.5\n        },\n        \"differentiation_summary\": \"Nux-v is the stronger choice...\"\n    }","operationId":"differentiate_remedies_api_remedies_differentiate_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RemedyComparisonRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/componen