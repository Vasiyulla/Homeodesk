# ============================================
# Homeopathy Backend — Environment Configuration
# ============================================
# Copy this file to .env and update values

# --- Environment ---
ENV=development
DEBUG=false
LOG_LEVEL=INFO

# --- JWT Authentication ---
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
# PostgreSQL (Required for both development and production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/homeopathy

# Connection Pool Tuning (PostgreSQL):
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Server ---
HOST=127.0.0.1
PORT=8000